# Local Worker secrets: copy to .dev.vars (never commit it).
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
# Channel3 live catalogue search key (keep server-side; never use VITE_ prefix).
CHANNEL3_API_KEY=your_channel3_api_key
# At least 32 random characters; signs short-lived live checkout snapshots.
BASKET_SIGNING_SECRET=replace_with_at_least_32_random_characters
